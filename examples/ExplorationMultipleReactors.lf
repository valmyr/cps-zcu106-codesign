target Codesign {
#  fpgaBoard: ZCU106,
  clock-period: 10 nsec
}
reactor R0_Fpga {
  input A: {= UInt(32.W) =}
  input B: {= UInt(32.W) =}
  output C: {= UInt(32.W) =}
  reaction(A, B) -> C {=
//    lf_write(C, lf_get(A) + lf_get(B))
  =}
}

reactor R1_Fpga {
  input C: {= UInt(32.W) =}
  output D: {= UInt(32.W) =}
  reaction(C) -> D {=
//    lf_write(D, lf_get(C))
  =}
}


reactor Hardware {

  input A: {= UInt(32.W) =}
  input B: {= UInt(32.W) =}
  output C: {= UInt(32.W) =}
  output D: {= UInt(32.W) =}


  r0 = new R0_Fpga()
  r1 = new R1_Fpga()

 A -> r0.A
 B -> r0.B  
 r0.C -> r1.C
 r1.D -> D
 r0.C -> C


}

reactor Software {
  input C: uint32_t
  input D: uint32_t
  output A: uint32_t
  output B: uint32_t

  timer t (0, 20 msec)
  reaction(t) -> A, B {=
    lf_set(A,1)
    lf_set(A,2)

  =}
}
main reactor {
  @fpga
  fpga = new Hardware()
  sw = new Software()
  fpga.C,fpga.D -> sw.C,sw.D
  sw.A,sw.B -> fpga.A,fpga.B
}

