// Minimal loopback in SIMULATION mode (Verilator).
// Same source code as the FPGA loopback: only the fpgaBoard line differs.
// Usage:  make compiler PROJECT=examples/loopback_sim.lf ARCH=x86_64
target Codesign {
    fpgaBoard: VerilatedTester,
    clock-period: 10 nsec,
    timeout: 1 sec
  }
reactor Fpga {
  input in: {= UInt(32.W) =}
  output out: {= UInt(32.W) =}
  reaction(in) -> out {=
    lf_set(out, lf_get(in))
  =}
}
reactor Sw {
  input in: uint32_t
  output out: uint32_t

  state cnt0: uint32_t = 0

  timer t(0, 200 nsec)

  reaction(t) -> out {=
    cnt0 += 1;
    out.set(cnt0);
  =}

  reaction(in) {=
    std::cout << std::endl
              << "[INFO] SW out = " << cnt0
              << ", HW in = " << *in.get()
              << std::endl << std::endl;
  =}
}
main reactor {
  @fpga
  fpga = new Fpga()
  sw = new Sw()
  sw.out, fpga.out -> fpga.in, sw.in
}
